<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta http-equiv="X-UA-Compatible" content="IE=edge" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Cek ID Game</title>
      <script src="https://cdn.tailwindcss.com"></script>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
      <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
      <script src="//unpkg.com/alpinejs" defer></script>

      <style>
         /* Custom styles for Choices.js to match the design */
         .choices {
            margin-bottom: 0;
         }

         .choices__inner {
            background-color: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 0.75rem;
            font-size: 0.875rem;
            min-height: 3rem;
            padding: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
         }

         .choices__inner:focus-within {
            border-color: rgba(59, 130, 246, 0.5);
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1), 0 10px 15px -3px rgba(0, 0, 0, 0.1);
         }

         .choices__list--dropdown {
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 0.75rem;
            background-color: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            z-index: 9999 !important;
         }

         .choices__item--selectable {
            padding: 0.75rem;
            border-radius: 0.5rem;
            margin: 0.25rem;
            transition: all 0.2s ease;
         }

         .choices__item--selectable:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            transform: translateY(-1px);
         }

         .choices__item--selectable.is-highlighted {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            transform: translateY(-1px);
         }

         .choices__input {
            font-size: 0.875rem;
            padding: 0;
         }

         .choices__input--cloned {
            margin-bottom: 0;
         }

         .choices__placeholder {
            opacity: 0.6;
         }

         /* Custom animations */
         @keyframes fadeInUp {
            from {
               opacity: 0;
               transform: translateY(30px);
            }
            to {
               opacity: 1;
               transform: translateY(0);
            }
         }

         @keyframes pulse {
            0%,
            100% {
               transform: scale(1);
            }
            50% {
               transform: scale(1.05);
            }
         }

         @keyframes shimmer {
            0% {
               background-position: -200px 0;
            }
            100% {
               background-position: calc(200px + 100%) 0;
            }
         }

         .animate-fade-in-up {
            animation: fadeInUp 0.6s ease-out;
         }

         .animate-pulse-slow {
            animation: pulse 2s infinite;
         }

         .glass-card {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
         }

         .glass-input {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
         }

         .glass-input:focus {
            background: rgba(255, 255, 255, 0.95);
            border-color: rgba(59, 130, 246, 0.5);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1), 0 10px 15px -3px rgba(0, 0, 0, 0.1);
         }

         .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
         }

         .gradient-bg-alt {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
         }

         .shimmer {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200px 100%;
            animation: shimmer 1.5s infinite;
         }

         .hover-lift {
            transition: all 0.3s ease;
         }

         .hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
         }

         /* Floating particles background */
         .floating-shapes {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
         }

         .floating-shape {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
            animation: float 20s infinite linear;
         }

         @keyframes float {
            0% {
               transform: translateY(100vh) rotate(0deg);
            }
            100% {
               transform: translateY(-100px) rotate(360deg);
            }
         }
      </style>
   </head>
   <body class="gradient-bg min-h-screen">
      <!-- Floating Background Shapes -->
      <div class="floating-shapes">
         <div class="floating-shape" style="width: 80px; height: 80px; left: 10%; animation-delay: 0s"></div>
         <div class="floating-shape" style="width: 60px; height: 60px; left: 20%; animation-delay: 2s"></div>
         <div class="floating-shape" style="width: 100px; height: 100px; left: 30%; animation-delay: 4s"></div>
         <div class="floating-shape" style="width: 70px; height: 70px; left: 40%; animation-delay: 6s"></div>
         <div class="floating-shape" style="width: 90px; height: 90px; left: 50%; animation-delay: 8s"></div>
         <div class="floating-shape" style="width: 75px; height: 75px; left: 60%; animation-delay: 10s"></div>
         <div class="floating-shape" style="width: 85px; height: 85px; left: 70%; animation-delay: 12s"></div>
         <div class="floating-shape" style="width: 65px; height: 65px; left: 80%; animation-delay: 14s"></div>
         <div class="floating-shape" style="width: 95px; height: 95px; left: 90%; animation-delay: 16s"></div>
      </div>

      <div class="w-full min-h-screen flex justify-center py-8" x-data="gameChecker()">
         <div class="md:w-1/2 w-full flex flex-col gap-6 px-4">
            <!-- Header -->
            <div class="glass-card rounded-2xl shadow-2xl px-6 py-8 text-center hover-lift animate-fade-in-up">
               <div class="flex items-center justify-center mb-4">
                  <div
                     class="w-12 h-12 gradient-bg-alt rounded-full flex items-center justify-center mr-4 animate-pulse-slow"
                  >
                     <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                           stroke-linecap="round"
                           stroke-linejoin="round"
                           stroke-width="2"
                           d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1a4 4 0 014 4v.172M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                     </svg>
                  </div>
                  <h1
                     class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent"
                  >
                     Game ID Checker
                  </h1>
               </div>
               <p class="text-gray-600 text-sm">Cek username dan validasi ID game favorit kamu dengan mudah</p>
            </div>

            <!-- Form -->
            <form
               @submit.prevent="submitForm"
               class="glass-card rounded-2xl shadow-2xl p-8 hover-lift animate-fade-in-up"
               style="animation-delay: 0.1s"
            >
               <div class="space-y-6">
                  <!-- Game Selection -->
                  <div class="space-y-3">
                     <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <span class="flex items-center">
                           <svg
                              class="w-4 h-4 mr-2 text-purple-600"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                           >
                              <path
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="2"
                                 d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
                              ></path>
                           </svg>
                           Select Game
                        </span>
                     </label>
                     <select
                        x-ref="gameSelect"
                        x-model="selectedGame"
                        class="w-full rounded-xl glass-input focus:outline-none transition-all duration-300"
                     >
                        <option value="" disabled>🎮 Select Your Favorite Game</option>
                        <template x-for="game in games" :key="game.endpoint">
                           <option
                              :value="game.endpoint"
                              :data-is-zone="game.hasZoneId"
                              :data-list-zone="game.listZoneId"
                           >
                              <span x-text="game.name"></span>
                           </option>
                        </template>
                     </select>
                  </div>

                  <!-- Game ID Input -->
                  <div class="space-y-3">
                     <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <span class="flex items-center">
                           <svg
                              class="w-4 h-4 mr-2 text-purple-600"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                           >
                              <path
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="2"
                                 d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-3c0-.265.105-.52.293-.707l5.964-5.964A6 6 0 1121 9z"
                              ></path>
                           </svg>
                           Game ID
                        </span>
                     </label>
                     <input
                        type="text"
                        x-model="gameId"
                        class="w-full p-4 rounded-xl glass-input focus:outline-none text-sm transition-all duration-300"
                        placeholder="🔢 Enter your Game ID"
                     />
                  </div>

                  <!-- Zone Input -->
                  <div
                     x-show="showZoneInput"
                     class="space-y-3"
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 transform scale-95"
                     x-transition:enter-end="opacity-100 transform scale-100"
                  >
                     <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <span class="flex items-center">
                           <svg
                              class="w-4 h-4 mr-2 text-purple-600"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                           >
                              <path
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="2"
                                 d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                              ></path>
                              <path
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="2"
                                 d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                              ></path>
                           </svg>
                           Zone ID
                        </span>
                     </label>
                     <input
                        x-show="zoneInputType === 'text'"
                        type="text"
                        x-model="zoneId"
                        class="w-full p-4 rounded-xl glass-input focus:outline-none text-sm transition-all duration-300"
                        placeholder="🗺️ Enter Zone ID"
                     />
                     <select
                        x-show="zoneInputType === 'select'"
                        x-ref="zoneSelect"
                        class="w-full rounded-xl glass-input focus:outline-none transition-all duration-300"
                     >
                        <option value="" disabled>🗺️ Select Zone</option>
                     </select>
                  </div>

                  <!-- Submit Button -->
                  <button
                     type="submit"
                     :disabled="isLoading"
                     :class="isLoading ? 'opacity-70 cursor-not-allowed' : 'hover:shadow-2xl hover:scale-105'"
                     class="w-full py-4 px-6 gradient-bg text-white font-semibold rounded-xl transition-all duration-300 transform focus:outline-none focus:ring-4 focus:ring-purple-300"
                  >
                     <span x-show="!isLoading" class="flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                           <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                           ></path>
                        </svg>
                        Check Now
                     </span>
                     <span x-show="isLoading" class="flex items-center justify-center">
                        <svg
                           class="animate-spin -ml-1 mr-3 h-5 w-5 text-white"
                           xmlns="http://www.w3.org/2000/svg"
                           fill="none"
                           viewBox="0 0 24 24"
                        >
                           <circle
                              class="opacity-25"
                              cx="12"
                              cy="12"
                              r="10"
                              stroke="currentColor"
                              stroke-width="4"
                           ></circle>
                           <path
                              class="opacity-75"
                              fill="currentColor"
                              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                           ></path>
                        </svg>
                        Checking...
                     </span>
                  </button>
               </div>
            </form>

            <!-- Result Card -->
            <div
               x-show="result.show"
               x-transition:enter="transition ease-out duration-500"
               x-transition:enter-start="opacity-0 transform scale-95 translate-y-4"
               x-transition:enter-end="opacity-100 transform scale-100 translate-y-0"
               class="glass-card rounded-2xl shadow-2xl p-8 hover-lift relative"
            >
               <!-- Dismiss Button -->
               <button
                  @click="result.show = false"
                  class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 focus:outline-none"
                  title="Close"
               >
                  <svg
                     xmlns="http://www.w3.org/2000/svg"
                     class="h-6 w-6"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                  >
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
               </button>
               <div class="flex items-center mb-6">
                  <div
                     class="w-10 h-10 rounded-full flex items-center justify-center mr-4"
                     :class="result.success ? 'bg-green-100' : 'bg-red-100'"
                  >
                     <svg
                        x-show="result.success"
                        class="w-6 h-6 text-green-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                     >
                        <path
                           stroke-linecap="round"
                           stroke-linejoin="round"
                           stroke-width="2"
                           d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                     </svg>
                     <svg
                        x-show="!result.success"
                        class="w-6 h-6 text-red-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                     >
                        <path
                           stroke-linecap="round"
                           stroke-linejoin="round"
                           stroke-width="2"
                           d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                     </svg>
                  </div>
                  <h3 class="text-2xl font-bold" :class="result.success ? 'text-green-600' : 'text-red-600'">
                     <span x-text="result.success ? '✅ Data Found!' : '❌ Failed'"></span>
                  </h3>
               </div>

               <template x-if="result.success">
                  <div class="space-y-4">
                     <div class="glass-card rounded-xl p-4 bg-gradient-to-r from-green-50 to-emerald-50 -z-50">
                        <div class="flex items-center justify-between py-2">
                           <span class="text-sm font-medium text-gray-600 flex items-center">
                              <svg
                                 class="w-4 h-4 mr-2 text-green-600"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24"
                              >
                                 <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                 ></path>
                              </svg>
                              Username
                           </span>
                           <span class="font-bold text-gray-800" x-text="result.data?.username || '-'"></span>
                        </div>
                     </div>

                     <div class="glass-card rounded-xl p-4 bg-gradient-to-r from-blue-50 to-indigo-50">
                        <div class="flex items-center justify-between py-2">
                           <span class="text-sm font-medium text-gray-600 flex items-center">
                              <svg
                                 class="w-4 h-4 mr-2 text-blue-600"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24"
                              >
                                 <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-3c0-.265.105-.52.293-.707l5.964-5.964A6 6 0 1121 9z"
                                 ></path>
                              </svg>
                              Game ID
                           </span>
                           <span class="font-bold text-gray-800" x-text="result.data?.user_id || '-'"></span>
                        </div>
                     </div>

                     <div
                        x-show="result.data?.zone || result.data?.zone_id"
                        class="glass-card rounded-xl p-4 bg-gradient-to-r from-purple-50 to-pink-50"
                     >
                        <div class="flex items-center justify-between py-2">
                           <span class="text-sm font-medium text-gray-600 flex items-center">
                              <svg
                                 class="w-4 h-4 mr-2 text-purple-600"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24"
                              >
                                 <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                 ></path>
                              </svg>
                              Zone
                           </span>
                           <span
                              class="font-bold text-gray-800"
                              x-text="result.data?.zone || result.data?.zone_id || '-'"
                           ></span>
                        </div>
                     </div>

                     <div
                        x-show="result.data?.region"
                        class="glass-card rounded-xl p-4 bg-gradient-to-r from-orange-50 to-red-50"
                     >
                        <div class="flex items-center justify-between py-2">
                           <span class="text-sm font-medium text-gray-600 flex items-center">
                              <svg
                                 class="w-4 h-4 mr-2 text-orange-600"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24"
                              >
                                 <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                 ></path>
                              </svg>
                              Region
                           </span>
                           <span class="font-bold text-gray-800" x-text="result.data?.region || '-'"></span>
                        </div>
                     </div>
                  </div>
               </template>

               <template x-if="!result.success">
                  <div class="glass-card rounded-xl p-6 bg-gradient-to-r from-red-50 to-pink-50 text-center">
                     <div class="mb-4">
                        <div class="w-16 h-16 mx-auto bg-red-100 rounded-full flex items-center justify-center">
                           <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="2"
                                 d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.866-.833-2.637 0L3.177 16.5c-.77.833.192 2.5 1.732 2.5z"
                              ></path>
                           </svg>
                        </div>
                     </div>
                     <p class="text-gray-700 font-medium" x-text="result.message"></p>
                     <p class="text-sm text-gray-500 mt-2">Make sure the entered ID and Zone are correct</p>
                  </div>
               </template>
            </div>

            <!-- Footer -->
            <div class="text-center py-6">
               <p class="text-white/80 text-sm">
                  Made with ❤️ for gamers •
                  <span class="font-semibold">Fast</span> • <span class="font-semibold">Reliable</span> •
                  <span class="font-semibold">Secure</span>
               </p>
            </div>
         </div>
      </div>

      <script>
         function gameChecker() {
            return {
               // Data properties
               games: [],
               selectedGame: '',
               gameId: '',
               zoneId: '',
               zoneOptions: [],
               showZoneInput: false,
               zoneInputType: 'text', // 'text' or 'select'
               isLoading: false,
               result: {
                  show: false,
                  success: false,
                  message: '',
                  data: null,
               },

               // Choices.js instances
               gameChoices: null,
               zoneChoices: null,

               // Initialize component
               async init() {
                  await this.loadGames();
                  this.initGameSelect();
               },

               // Initialize searchable game select
               initGameSelect() {
                  this.$nextTick(() => {
                     if (this.$refs.gameSelect) {
                        this.gameChoices = new Choices(this.$refs.gameSelect, {
                           searchEnabled: true,
                           searchPlaceholderValue: 'Search game...',
                           noResultsText: 'No games found',
                           noChoicesText: 'No choices available',
                           itemSelectText: 'Press to select',
                           shouldSort: false,
                           classNames: {
                              containerOuter: 'choices',
                              containerInner: 'choices__inner',
                              input: 'choices__input',
                              inputCloned: 'choices__input--cloned',
                              list: 'choices__list',
                              listItems: 'choices__list--multiple',
                              listSingle: 'choices__list--single',
                              listDropdown: 'choices__list--dropdown',
                              item: 'choices__item',
                              itemSelectable: 'choices__item--selectable',
                              itemDisabled: 'choices__item--disabled',
                              itemChoice: 'choices__item--choice',
                              placeholder: 'choices__placeholder',
                              group: 'choices__group',
                              groupHeading: 'choices__heading',
                              button: 'choices__button',
                           },
                        });

                        // Listen for choice selection
                        this.$refs.gameSelect.addEventListener('choice', (event) => {
                           console.log('Game selected:', event);
                           this.selectedGame = event.detail.value;
                           this.handleGameChange();
                        });
                     }
                  });
               },

               // Initialize searchable zone select
               initZoneSelect() {
                  this.$nextTick(() => {
                     if (this.$refs.zoneSelect && this.zoneInputType === 'select') {
                        // Destroy existing instance if any
                        if (this.zoneChoices) {
                           this.zoneChoices.destroy();
                        }

                        // Clear and populate select options
                        this.$refs.zoneSelect.innerHTML = '<option value="" disabled>🗺️ Select Zone</option>';
                        this.zoneOptions.forEach((zone) => {
                           const option = document.createElement('option');
                           option.value = zone.zoneId;
                           option.textContent = zone.name;
                           this.$refs.zoneSelect.appendChild(option);
                        });

                        this.zoneChoices = new Choices(this.$refs.zoneSelect, {
                           searchEnabled: true,
                           searchPlaceholderValue: 'Search zone...',
                           noResultsText: 'No zones found',
                           noChoicesText: 'No choices available',
                           itemSelectText: 'Press to select',
                           shouldSort: false,
                        });

                        // Listen for choice selection and extract the actual value
                        this.$refs.zoneSelect.addEventListener('choice', (event) => {
                           const selectedValue = event.detail.choice.value;
                           console.log('Selected zone value:', selectedValue);
                           this.zoneId = selectedValue;
                        });

                        // Also listen for change event as backup
                        this.$refs.zoneSelect.addEventListener('change', (event) => {
                           const selectedValue = event.target.value;
                           console.log('Zone changed to:', selectedValue);
                           this.zoneId = selectedValue;
                        });
                     }
                  });
               },

               // Load games from API
               async loadGames() {
                  try {
                     const response = await fetch('/list-game');
                     const data = await response.json();
                     this.games = data.data;
                  } catch (error) {
                     console.error('Error loading games:', error);
                  }
               },

               // Handle game selection change
               async handleGameChange() {
                  console.log('Selected game:', this.selectedGame);
                  const selectedGameData = this.games.find((game) => game.endpoint === this.selectedGame);

                  if (!selectedGameData) {
                     this.showZoneInput = false;
                     return;
                  }

                  // Reset zone data and destroy existing zone choices
                  this.zoneId = '';
                  this.zoneOptions = [];
                  if (this.zoneChoices) {
                     this.zoneChoices.destroy();
                     this.zoneChoices = null;
                  }

                  if (selectedGameData.hasZoneId) {
                     this.showZoneInput = true;

                     if (selectedGameData.listZoneId && selectedGameData.listZoneId !== 'null') {
                        // Load zone options from API
                        this.zoneInputType = 'select';
                        await this.loadZoneOptions(selectedGameData.listZoneId);
                     } else {
                        // Show text input for zone
                        this.zoneInputType = 'text';
                     }
                  } else {
                     this.showZoneInput = false;
                  }
               },

               // Load zone options from API
               async loadZoneOptions(zoneEndpoint) {
                  try {
                     const response = await fetch(zoneEndpoint);
                     const data = await response.json();
                     this.zoneOptions = data.data || [];

                     // Initialize searchable zone select after data is loaded
                     this.initZoneSelect();

                     // Auto-select first zone if available
                     if (this.zoneOptions.length > 0) {
                        this.zoneId = this.zoneOptions[0].zoneId;

                        // Update Choices.js selection if it exists
                        this.$nextTick(() => {
                           if (this.zoneChoices) {
                              this.zoneChoices.setChoiceByValue(this.zoneId);
                           }
                        });
                     }
                  } catch (error) {
                     console.error('Error loading zone options:', error);
                     // Fallback to text input if API fails
                     this.zoneInputType = 'text';
                  }
               },

               // Submit form
               async submitForm() {
                  // Validation
                  console.log('ZOneId', this.zoneId);
                  if (!this.gameId || !this.selectedGame) {
                     alert('Game ID and Game must not be empty');
                     return;
                  }

                  if (this.showZoneInput && !this.zoneId) {
                     alert('Zone ID must not be empty');
                     return;
                  }

                  // Set loading state
                  this.isLoading = true;
                  this.result.show = false;

                  try {
                     const zoneParam = this.showZoneInput ? this.zoneId : '';

                     const url = `${this.selectedGame.value}?id=${encodeURIComponent(this.gameId)}&zone=${zoneParam}`;

                     const response = await fetch(url);
                     const data = await response.json();

                     // Show result
                     this.result = {
                        show: true,
                        success: data.status,
                        message: data.message || 'Unknown error',
                        data: data.data || null,
                     };
                  } catch (error) {
                     console.error('Error submitting form:', error);
                     this.result = {
                        show: true,
                        success: false,
                        message: 'Network error occurred',
                        data: null,
                     };
                  } finally {
                     this.isLoading = false;
                  }
               },
            };
         }
      </script>
   </body>
</html>
